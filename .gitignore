!web/vendor/maplibre-gl.js
!web/vendor/maplibre-gl.css

# PRIVATE field data — never push to GitHub
tds_data/
*.json
!.streamlit/*.json

# Build output
build/
dist/
_diag_py.txt

# Streamlit local config
.streamlit/secrets.toml
